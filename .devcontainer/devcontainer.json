{
  "name": "opcua-edge-bridge demo",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "20" }
  },
  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y --no-install-recommends mosquitto && pip install -r requirements-dev.txt && cd nodered && npm ci --no-audit --no-fund",
  "postAttachCommand": "./scripts/demo.sh",
  "forwardPorts": [1880],
  "portsAttributes": {
    "1880": { "label": "Dashboard", "onAutoForward": "openBrowser" },
    "1883": { "label": "MQTT broker", "onAutoForward": "silent" },
    "4842": { "label": "OPC UA simulator", "onAutoForward": "silent" }
  },
  "customizations": {
    "codespaces": { "openFiles": ["README.md"] },
    "vscode": { "extensions": ["ms-python.python"] }
  }
}
