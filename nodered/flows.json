  {
    "id": "f_audit",
    "type": "function",
    "name": "keep last 20",
    "func": "const rows = context.get('rows') || [];\nconst r = msg.payload || {};\nrows.unshift({time: new Date(r.ts * 1000).toLocaleTimeString(), signal: r.signal,\n  requested: JSON.stringify(r.requested), previous: JSON.stringify(r.previous),\n  result: r.result, reason: r.reason || ''});\nrows.length = Math.min(rows.length, 20);\ncontext.set('rows', rows);\nreturn {payload: rows};",
    "outputs": 1,
    "wires": [
      [
        "tbl_audit"
      ]
    ],
    "x": 600,
    "y": 1120,
    "z": "tab_bridge"
