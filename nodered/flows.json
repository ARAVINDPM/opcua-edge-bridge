[
  {
    "id": "tab_bridge",
    "type": "tab",
    "label": "Edge bridge demo",
    "disabled": false,
    "info": "Subscribes to the bridge's MQTT topics and shows values, bridge state and the write audit trail."
  },
  {
    "id": "broker",
    "type": "mqtt-broker",
    "name": "local broker",
    "broker": "${MQTT_HOST}",
    "port": "1883",
    "clientid": "",
    "autoConnect": true,
    "usetls": false,
    "protocolVersion": "4",
    "keepalive": "30",
    "cleansession": true,
    "autoUnsubscribe": true
  },
  {
    "id": "ui_base",
    "type": "ui-base",
    "name": "Edge bridge",
