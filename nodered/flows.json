  {
    "id": "f_data",
    "type": "function",
    "name": "route by signal",
    "func": "const p = msg.payload || {};\nconst n = (context.get('n') || 0) + 1; context.set('n', n);\nconst out = [null, null, null, null, null, null, {payload: n}];\nconst v = {topic: p.signal, payload: p.value};\nif (p.signal && p.signal.startsWith('sample_')) {\n  out[0] = v;\n  if (p.source_ts) out[5] = {payload: Math.round((p.bridge_ts - p.source_ts) * 1000) + ' ms'};\n}\nelse if (p.signal === 'memory_usage') out[1] = v;\nelse if (p.signal === 'led_1') out[2] = {payload: !!p.value};\nelse if (p.signal === 'do_1') out[3] = {payload: !!p.value};\nelse if (p.signal === 'di_1') out[4] = {payload: p.value ? 'HIGH' : 'LOW'};\nreturn out;",
    "outputs": 7,
    "wires": [
      [
        "c_samples"
      ],
      [
        "g_mem"
      ],
      [
        "sw_led"
      ],
      [
        "sw_do"
      ],
      [
        "t_di"
      ],
      [
        "t_delay"
      ],
      [
        "t_count"
      ]
    ],
    "x": 600,
    "y": 760,
    "z": "tab_bridge"
  },
